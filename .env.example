# Public Turnstile widget key. This value is included in the browser build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Set the following as encrypted Cloudflare Pages secrets, not in a local .env file committed to Git.
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
PURELYMAIL_SMTP_PASSWORD=replace_with_dedicated_mailbox_or_app_password

# Optional. Omit this when the Purelymail user matches FORM_FROM_EMAIL.
PURELYMAIL_SMTP_USERNAME=forms@sanaresolutions.ca

# Non-secret delivery configuration. This default also appears in wrangler.jsonc.
FORM_FROM_EMAIL=forms@sanaresolutions.ca
